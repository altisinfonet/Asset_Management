# Copy to .env (uncommitted) to override docker-compose defaults. Dummy dev credentials only.

# Host ports published by docker compose
API_PORT=3000
WEB_PORT=3001
POSTGRES_PORT=5433        # 5432 is often taken by a local Postgres
PGBOUNCER_PORT=6432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- apps/api runtime configuration (see apps/api/src/config/env.ts) ---
NODE_ENV=development
APP_ROLE=api                         # api | worker | scheduler | migrate (or pass as the command arg)
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Runtime role (app, non-owner) through PgBouncer in transaction mode
DATABASE_URL=postgres://app:dev@localhost:6432/app
# Migrations: owner role, DIRECT to Postgres (never through the pooler)
MIGRATOR_DATABASE_URL=postgres://migrator:dev@localhost:5433/app

S3_ENDPOINT=http://localhost:9000
SMTP_URL=smtp://localhost:1025

# --- apps/web (dev server only; the production build is a static export) ---
API_PROXY_URL=http://localhost:3000   # target of the dev-only /v1 proxy
