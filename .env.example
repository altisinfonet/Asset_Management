# Copy to .env (uncommitted) to override docker-compose defaults. Dummy dev credentials only.

# Host ports published by docker compose
API_PORT=3000
WEB_PORT=3001
POSTGRES_PORT=5433        # 5432 is often taken by a local Postgres
PGBOUNCER_PORT=6432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- apps/api runtime configuration (see apps/api/src/config/env.ts) ---
NODE_ENV=development
APP_ROLE=api                         # api | worker | scheduler | migrate (or pass as the command arg)
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Runtime role (app_user, non-owner, NOBYPASSRLS) through PgBouncer in transaction mode
DATABASE_URL=postgres://app_user:dev@localhost:6432/app
# Migrations: owner role (app_owner), DIRECT to Postgres (never through the pooler)
MIGRATOR_DATABASE_URL=postgres://app_owner:dev@localhost:5433/app
# migrate role only: also create the demo tenants Acme and Globex (dev; refused when NODE_ENV=production)
SEED_DEMO_DATA=false

# Tenant isolation suite (pnpm --filter @assettracker/api test:e2e); see apps/api/test/isolation
#   direct : DATABASE_URL=postgres://app_user:dev@localhost:5433/app          ISOLATION_MODE=direct
#   pooled : DATABASE_URL=postgres://app_user:dev@localhost:6432/app          ISOLATION_MODE=pooled
#            POOLED_ONE_URL=postgres://app_user:dev@localhost:6432/app_one   (pool_size=1 alias, negative control)
# ADMIN_DATABASE_URL=postgres://postgres:dev@localhost:5433/app              (optional: BYPASSRLS lint fixture)

S3_ENDPOINT=http://localhost:9000
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Asset Tracker <no-reply@assettracker.local>
# Mailpit HTTP API (e2e tests read delivered mail from it): MAILPIT_API_URL=http://localhost:8025

# --- Platform services (worker, scheduler, secrets, observability) ---
# Envelope-encryption master key: 32 random bytes, base64 (openssl rand -base64 32). Prefer the _FILE
# form (a Docker secret); production refuses to start without one. Rotation: set the new key + a new
# MASTER_KEY_ID, keep the old as MASTER_KEY_PREVIOUS(_FILE) + MASTER_KEY_PREVIOUS_ID until re-wrapped.
# MASTER_KEY_FILE=/run/secrets/master_key
# MASTER_KEY_ID=mk1
# scheduler role only: owner role, DIRECT to Postgres (never through the pooler)
# MAINTENANCE_DATABASE_URL=postgres://app_owner:dev@localhost:5433/app
# Job polling is 1-2 s (no LISTEN/NOTIFY behind PgBouncer); per-tenant fairness per worker process
# JOBS_POLL_SECONDS=1
# JOBS_TENANT_CONCURRENCY=2
# Internal ops server: /metrics (all roles), /healthz + /readyz (worker, scheduler). Never publish it.
# OPS_PORT=9464
# Tracing is off unless an OTLP/HTTP endpoint is set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- apps/web (dev server only; the production build is a static export) ---
API_PROXY_URL=http://localhost:3000   # target of the dev-only /v1 proxy
