{
  "name": "@assettracker/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS modular monolith (Fastify adapter). One image, many roles: api | worker | scheduler | migrate",
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist",
    "migrations",
    "openapi.generated.json"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/ensure-generated.mjs && tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js api",
    "migrate": "node dist/main.js migrate",
    "cli": "node dist/cli/main.js",
    "seed": "node dist/cli/main.js seed",
    "schema:lint": "node dist/cli/main.js schema:lint",
    "db:pull": "node scripts/db-pull.mjs",
    "lint": "eslint .",
    "typecheck": "node scripts/ensure-generated.mjs && tsc --noEmit",
    "test": "node scripts/ensure-generated.mjs && vitest run",
    "test:e2e": "node scripts/ensure-generated.mjs && vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "openapi:bundle": "node scripts/bundle-openapi.mjs"
  },
  "dependencies": {
    "@assettracker/schemas": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-fastify": "12.5.1",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "nestjs-pino": "5.3.2",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@swc/core": "1.16.22",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "js-yaml": "4.3.2",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
