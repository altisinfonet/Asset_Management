generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app", "identity"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accessory {
  id                  String        @id @db.Uuid
  tenant_id           String        @db.Uuid
  company_id          String        @db.Uuid
  category_id         String        @db.Uuid
  category_kind       String        @default("accessory")
  manufacturer_id     String?       @db.Uuid
  vendor_id           String?       @db.Uuid
  location_id         String?       @db.Uuid
  name                String
  model_number        String?
  qty_total           Int           @default(0)
  min_qty             Int           @default(0)
  purchase_date       DateTime?     @db.Date
  purchase_cost_minor BigInt?
  currency            String?
  notes               String?
  label_code          String        @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  low_stock_alerted   Boolean       @default(false)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @default(now()) @db.Timestamptz(6)
  created_by          String?       @db.Uuid
  updated_by          String?       @db.Uuid
  archived_at         DateTime?     @db.Timestamptz(6)
  version             Int           @default(1)
  search_text         String?       @default(dbgenerated("lower(((name || chr(31)) || COALESCE(model_number, ''::text)))"))
  category            category      @relation(fields: [tenant_id, category_id, category_kind], references: [tenant_id, id, kind], onDelete: NoAction, onUpdate: NoAction)
  company             company       @relation(fields: [tenant_id, company_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  tenant              tenant        @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location            location?     @relation(fields: [tenant_id, location_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  manufacturer        manufacturer? @relation(fields: [tenant_id, manufacturer_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  vendor              vendor?       @relation(fields: [tenant_id, vendor_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  assignment          assignment[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, label_code])
  @@index([tenant_id, category_id], map: "accessory_category_idx")
  @@index([tenant_id, location_id], map: "accessory_location_idx", where: raw("(location_id IS NOT NULL)"))
  @@index([tenant_id, name, id], map: "accessory_name_idx")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model api_key {
  id             String           @id @db.Uuid
  tenant_id      String           @db.Uuid
  name           String
  key_prefix     String
  scopes         String[]         @default([])
  expires_at     DateTime?        @db.Timestamptz(6)
  last_used_at   DateTime?        @db.Timestamptz(6)
  last_used_ip   String?          @db.Inet
  revoked_at     DateTime?        @db.Timestamptz(6)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  created_by     String?          @db.Uuid
  version        Int              @default(1)
  tenant         tenant           @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  api_key_lookup api_key_lookup[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, key_prefix])
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model asset {
  id                                                     String              @id @db.Uuid
  tenant_id                                              String              @db.Uuid
  company_id                                             String              @db.Uuid
  asset_tag                                              String
  label_code                                             String              @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  name                                                   String?
  serial                                                 String?
  category_id                                            String              @db.Uuid
  category_kind                                          String              @default("asset")
  model_id                                               String?             @db.Uuid
  status_id                                              String              @db.Uuid
  location_id                                            String?             @db.Uuid
  vendor_id                                              String?             @db.Uuid
  parent_asset_id                                        String?             @db.Uuid
  purchase_date                                          DateTime?           @db.Date
  purchase_cost_minor                                    BigInt?
  currency                                               String?
  order_number                                           String?
  warranty_end                                           DateTime?           @db.Date
  notes                                                  String?
  custom_data                                            Json                @default("{}")
  external_source                                        String?
  external_id                                            String?
  created_at                                             DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                             DateTime            @default(now()) @db.Timestamptz(6)
  created_by                                             String?             @db.Uuid
  updated_by                                             String?             @db.Uuid
  archived_at                                            DateTime?           @db.Timestamptz(6)
  version                                                Int                 @default(1)
  asset_tag_key                                          String?             @default(dbgenerated("lower(asset_tag)"))
  serial_key                                             String?             @default(dbgenerated("lower(serial)"))
  search_text                                            String?             @default(dbgenerated("lower(((((asset_tag || chr(31)) || COALESCE(serial, ''::text)) || chr(31)) || COALESCE(name, ''::text)))"))
  disposed_on                                            DateTime?           @db.Date
  disposal_reason                                        String?
  disposal_note                                          String?
  image_attachment_id                                    String?             @db.Uuid
  department_id                                          String?             @db.Uuid
  department                                             department?         @relation(fields: [tenant_id, department_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "asset_department_fk")
  attachment                                             attachment?         @relation(fields: [tenant_id, image_attachment_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "asset_image_attachment_fk")
  location                                               location?           @relation(fields: [tenant_id, location_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "asset_location_fk")
  category                                               category            @relation(fields: [tenant_id, category_id, category_kind], references: [tenant_id, id, kind], onDelete: NoAction, onUpdate: NoAction)
  company                                                company             @relation(fields: [tenant_id, company_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  tenant                                                 tenant              @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset_model                                            asset_model?        @relation(fields: [tenant_id, model_id, category_id], references: [tenant_id, id, category_id], onDelete: NoAction, onUpdate: NoAction)
  asset                                                  asset?              @relation("assetToasset", fields: [tenant_id, parent_asset_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  other_asset                                            asset[]             @relation("assetToasset")
  status_label                                           status_label        @relation(fields: [tenant_id, status_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  vendor                                                 vendor?             @relation(fields: [tenant_id, vendor_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  asset_history                                          asset_history[]
  assignment_assignment_tenant_id_asset_idToasset        assignment?         @relation("assignment_tenant_id_asset_idToasset")
  assignment_assignment_tenant_id_target_asset_idToasset assignment[]        @relation("assignment_tenant_id_target_asset_idToasset")
  loaner_pool_member                                     loaner_pool_member?
  maintenance_record                                     maintenance_record?
  transfer                                               transfer[]

  @@unique([tenant_id, asset_tag_key], map: "asset_tag_uq")
  @@unique([tenant_id, external_source, external_id])
  @@unique([tenant_id, id])
  @@unique([tenant_id, label_code])
  @@index([tenant_id, category_id, id(sort: Desc)], map: "asset_category_idx", where: raw("(archived_at IS NULL)"))
  @@index([tenant_id, company_id], map: "asset_company_idx")
  @@index([tenant_id, created_at(sort: Desc), id(sort: Desc)], map: "asset_created_idx", where: raw("(archived_at IS NULL)"))
  @@index([tenant_id, department_id], map: "asset_department_idx", where: raw("(department_id IS NOT NULL)"))
  @@index([tenant_id, image_attachment_id], map: "asset_image_idx", where: raw("(image_attachment_id IS NOT NULL)"))
  @@index([tenant_id, location_id, id(sort: Desc)], map: "asset_location_idx", where: raw("(archived_at IS NULL)"))
  @@index([tenant_id, model_id], map: "asset_model_idx", where: raw("(model_id IS NOT NULL)"))
  @@index([tenant_id, parent_asset_id], map: "asset_parent_idx", where: raw("(parent_asset_id IS NOT NULL)"))
  @@index([tenant_id, serial_key], map: "asset_serial_idx")
  @@index([tenant_id, status_id, id(sort: Desc)], map: "asset_status_idx", where: raw("(archived_at IS NULL)"))
  @@index([tenant_id, updated_at(sort: Desc), id(sort: Desc)], map: "asset_updated_idx")
  @@index([tenant_id, vendor_id], map: "asset_vendor_idx", where: raw("(vendor_id IS NOT NULL)"))
  @@index([tenant_id, warranty_end], map: "asset_warranty_idx", where: raw("((warranty_end IS NOT NULL) AND (archived_at IS NULL))"))
  @@schema("app")
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
