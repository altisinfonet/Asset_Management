  location_assignment_tenant_id_checkin_location_idTolocation location?       @relation("assignment_tenant_id_checkin_location_idTolocation", fields: [tenant_id, checkin_location_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  tenant                                                      tenant          @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location_assignment_tenant_id_location_idTolocation         location?       @relation("assignment_tenant_id_location_idTolocation", fields: [tenant_id, location_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
