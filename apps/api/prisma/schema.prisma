model asset_history {
  id            String      @db.Uuid
  tenant_id     String      @db.Uuid
  asset_id      String      @db.Uuid
  at            DateTime    @default(now()) @db.Timestamptz(6)
  event_type    String
  actor_type    String      @default("user")
  actor_id      String?     @db.Uuid
  assignment_id String?     @db.Uuid
  transfer_id   String?     @db.Uuid
  summary       String?
  payload       Json        @default("{}")
  request_id    String?
  asset         asset       @relation(fields: [tenant_id, asset_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  assignment    assignment? @relation(fields: [tenant_id, assignment_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  tenant        tenant      @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transfer      transfer?   @relation(fields: [tenant_id, transfer_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, at])
  @@index([tenant_id, asset_id, at(sort: Desc), id(sort: Desc)], map: "asset_history_asset_idx")
  @@index([tenant_id, assignment_id], map: "asset_history_assignment_idx", where: raw("(assignment_id IS NOT NULL)"))
  @@index([tenant_id, transfer_id], map: "asset_history_transfer_idx", where: raw("(transfer_id IS NOT NULL)"))
  @@schema("app")
}

