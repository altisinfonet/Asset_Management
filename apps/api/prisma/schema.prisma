  @@unique([tenant_id, id, category_id])
  @@unique([tenant_id, id])
  @@index([tenant_id, category_id], map: "asset_model_category_idx")
  @@index([tenant_id, image_attachment_id], map: "asset_model_image_idx", where: raw("(image_attachment_id IS NOT NULL)"))
  @@index([tenant_id, manufacturer_id], map: "asset_model_manufacturer_idx")
