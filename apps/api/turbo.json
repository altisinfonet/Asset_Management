{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "$TURBO_ROOT$/docs/engineering/openapi.yaml"],
      "outputs": ["dist/**", "openapi.generated.json"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/engineering/openapi.yaml"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/engineering/openapi.yaml"]
    }
  }
}
