{
  "name": "@assettracker/web",
  "version": "0.2.8",
  "private": true,
  "description": "Next.js 16 App Router admin UI, static export only (no Node runtime in production)",
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:mock": "node scripts/dev-mock.mjs --port 3001",
    "build:mock": "node scripts/build-mock.mjs",
    "build": "node scripts/check-static-export.mjs && next build && node scripts/check-static-export.mjs --built",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build-mock.mjs && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:real": "node scripts/e2e-real.mjs",
    "check:static": "node scripts/check-static-export.mjs",
    "serve": "node scripts/serve-static.mjs out"
  },
  "dependencies": {
    "@assettracker/api-client": "workspace:*",
    "@assettracker/ui-tokens": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "msw": "2.15.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
