{
  "$description": "Asset Tracker design tokens (W3C Design Tokens Community Group format: $type/$value). Consumed by packages/ui-tokens to generate CSS variables (web) and a TS theme object (React Native). Colour values are sRGB hex. Every text/background pair is contrast-verified; see docs/design/design_system.md section 5.",
  "color": {
    "$type": "color",
    "light": {
      "bg": { "$value": "#F6F7F9", "$description": "App canvas behind surfaces" },
      "surface": { "$value": "#FFFFFF", "$description": "Cards, tables, drawers, dialogs, inputs" },
      "sunken": { "$value": "#EDEFF3", "$description": "Table header, wells, hover row, code blocks" },
      "text": { "$value": "#14171F", "$description": "Primary text" },
      "muted": { "$value": "#4A5365", "$description": "Secondary text, placeholders, helper text (still 4.5:1)" },
      "border": { "$value": "#D6DAE1", "$description": "Decorative dividers, card outlines (not required to meet 3:1)" },
      "border-strong": { "$value": "#7A8294", "$description": "Input, checkbox, radio outlines (meets 3:1 UI contrast)" },
      "focus": { "$value": "#1B4FD8", "$description": "2px focus ring + 2px offset; meets 3:1 on bg, surface, sunken, primary" },
      "scrim": { "$value": "#0B0E14", "$description": "Modal scrim colour; use at 50% opacity" },
      "primary": {
        "solid": { "$value": "#2A55D6", "$description": "Primary button, selected nav indicator, active toggle" },
        "hover": { "$value": "#2147B8" },
        "on": { "$value": "#FFFFFF", "$description": "Text/icon on primary.solid" },
        "subtle": { "$value": "#E7EDFC", "$description": "Selected row, selected nav item, info chips" },
        "text": { "$value": "#1E43AD", "$description": "Links and primary-coloured text on bg/surface/subtle" }
      },
      "success": {
        "solid": { "$value": "#157A45" },
        "on": { "$value": "#FFFFFF" },
        "subtle": { "$value": "#E3F4EA" },
        "text": { "$value": "#0F6035" }
      },
      "warning": {
        "solid": { "$value": "#A8510A" },
        "on": { "$value": "#FFFFFF" },
        "subtle": { "$value": "#FDF0D5" },
        "text": { "$value": "#7A3B05" }
      },
      "danger": {
        "solid": { "$value": "#C0262D" },
        "on": { "$value": "#FFFFFF" },
        "subtle": { "$value": "#FCE8E8" },
        "text": { "$value": "#9C1C22" }
      },
      "info": {
        "solid": { "$value": "#0B6E99" },
        "on": { "$value": "#FFFFFF" },
        "subtle": { "$value": "#E1F2F9" },
        "text": { "$value": "#085777" }
      }
    },
    "dark": {
      "bg": { "$value": "#0E1117", "$description": "App canvas behind surfaces" },
      "surface": { "$value": "#161A22", "$description": "Cards, tables, drawers, dialogs, inputs" },
      "sunken": { "$value": "#1E232D", "$description": "Table header, wells, hover row" },
      "text": { "$value": "#E9ECF2", "$description": "Primary text" },
      "muted": { "$value": "#A5AEBF", "$description": "Secondary text, placeholders, helper text" },
      "border": { "$value": "#2C3340", "$description": "Decorative dividers, card outlines" },
      "border-strong": { "$value": "#7C8699", "$description": "Input, checkbox, radio outlines (meets 3:1 UI contrast)" },
      "focus": { "$value": "#8CAEFF", "$description": "2px focus ring + 2px offset" },
      "scrim": { "$value": "#000000", "$description": "Modal scrim colour; use at 60% opacity" },
      "primary": {
        "solid": { "$value": "#7AA2FF" },
        "hover": { "$value": "#93B3FF" },
        "on": { "$value": "#0A1228", "$description": "Dark text on light-blue solid in dark mode" },
        "subtle": { "$value": "#1B2A4F" },
        "text": { "$value": "#9DBAFF" }
      },
      "success": {
        "solid": { "$value": "#3DBE82" },
        "on": { "$value": "#04170E" },
        "subtle": { "$value": "#12301F" },
        "text": { "$value": "#6FD9A3" }
      },
      "warning": {
        "solid": { "$value": "#E8A23A" },
        "on": { "$value": "#1C1000" },
        "subtle": { "$value": "#38270B" },
        "text": { "$value": "#F2C068" }
      },
      "danger": {
        "solid": { "$value": "#F0686E" },
        "on": { "$value": "#1F0507" },
        "subtle": { "$value": "#3B1518" },
        "text": { "$value": "#FF9A9F" }
      },
      "info": {
        "solid": { "$value": "#4DB6E3" },
        "on": { "$value": "#041823" },
        "subtle": { "$value": "#0F2E3D" },
        "text": { "$value": "#82CDEE" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Inter if bundled locally by the app; otherwise the system UI font. No remote font loading (self-hosted/air-gapped editions)." },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"], "$description": "Asset tags, serial numbers, codes" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px", "$description": "Badges, captions, table meta (not for essential body text on mobile)" },
      "sm": { "$value": "13px", "$description": "Dense table cells" },
      "base": { "$value": "14px", "$description": "Web admin body" },
      "md": { "$value": "16px", "$description": "Mobile body; form inputs on mobile (prevents iOS zoom)" },
      "lg": { "$value": "18px", "$description": "Section titles, mobile card title" },
      "xl": { "$value": "20px", "$description": "Page title (web)" },
      "2xl": { "$value": "24px", "$description": "Page title (large), mobile screen title" },
      "3xl": { "$value": "30px", "$description": "Onboarding / login headline" }
    },
    "lineHeight": {
      "$type": "dimension",
      "xs": { "$value": "16px" },
      "sm": { "$value": "20px" },
      "base": { "$value": "20px" },
      "md": { "$value": "24px" },
      "lg": { "$value": "26px" },
      "xl": { "$value": "28px" },
      "2xl": { "$value": "32px" },
      "3xl": { "$value": "38px" }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "0.5": { "$value": "2px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "size": {
    "$type": "dimension",
    "control-dense": { "$value": "28px", "$description": "Web dense table-row controls (min target 24x24 per WCAG 2.5.8)" },
    "control": { "$value": "36px", "$description": "Web default input/button height" },
    "control-touch": { "$value": "44px", "$description": "Mobile minimum touch target (iOS HIG 44pt)" },
    "control-touch-lg": { "$value": "52px", "$description": "Mobile primary action button" },
    "icon-sm": { "$value": "16px" },
    "icon-md": { "$value": "20px" },
    "icon-lg": { "$value": "24px" },
    "sidebar": { "$value": "232px" },
    "sidebar-collapsed": { "$value": "56px" },
    "drawer": { "$value": "480px" },
    "content-max": { "$value": "1440px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px", "$description": "Badges, checkboxes, table chips" },
    "md": { "$value": "6px", "$description": "Inputs, buttons" },
    "lg": { "$value": "8px", "$description": "Cards, popovers, menus" },
    "xl": { "$value": "12px", "$description": "Dialogs, drawers, mobile bottom sheets (top corners)" },
    "full": { "$value": "9999px", "$description": "Pills, avatars, switches" }
  },
  "shadow": {
    "$type": "shadow",
    "light": {
      "sm": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#14171F14" } },
      "md": { "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px", "color": "#14171F1F" } },
      "lg": { "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-4px", "color": "#14171F2E" } }
    },
    "dark": {
      "sm": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#00000066" } },
      "md": { "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px", "color": "#00000080" } },
      "lg": { "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-4px", "color": "#000000A6" } }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "100ms" },
    "base": { "$value": "160ms" },
    "slow": { "$value": "240ms" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  },
  "zIndex": {
    "$type": "number",
    "sticky": { "$value": 10 },
    "drawer": { "$value": 40 },
    "dialog": { "$value": 50 },
    "popover": { "$value": 60 },
    "toast": { "$value": 70 }
  }
}
