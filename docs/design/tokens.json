{
  "$description": "Asset Tracker design tokens (W3C Design Tokens Community Group format: $type/$value). Consumed by packages/ui-tokens to generate CSS variables (web) and a TS theme object (React Native). Colour values are sRGB hex. Every text/background pair is contrast-verified; see docs/design/design_system.md section 5.",
  "color": {
    "$type": "color",
    "light": {
      "bg": { "$value": "#F1F5F9", "$description": "App canvas behind surfaces" },
      "surface": { "$value": "#FFFFFF", "$description": "Cards, tables, drawers, dialogs, inputs" },
      "sunken": { "$value": "#E9EEF4", "$description": "Table header, wells, hover row, code blocks" },
      "text": { "$value": "#0F172A", "$description": "Primary text" },
      "muted": { "$value": "#475569", "$description": "Secondary text, placeholders, helper text (still 4.5:1)" },
      "border": { "$value": "#E2E8F0", "$description": "Decorative dividers, card outlines (not required to meet 3:1)" },
      "border-strong": { "$value": "#64748B", "$description": "Input, checkbox, radio outlines (meets 3:1 UI contrast)" },
      "focus": { "$value": "#1D4ED8", "$description": "2px focus ring + 2px offset; meets 3:1 on bg, surface, sunken, primary" },
      "scrim": { "$value": "#020617", "$description": "Modal scrim colour; use at 50% opacity" },
      "primary": {
        "solid": { "$value": "#0F766E", "$description": "Primary button, selected nav indicator, active toggle" },
        "hover": { "$value": "#115E59" },
        "on": { "$value": "#FFFFFF", "$description": "Text/icon on primary.solid" },
        "subtle": { "$value": "#E6F6F3", "$description": "Selected row, selected nav item, info chips" },
        "text": { "$value": "#0F6A63", "$description": "Links and primary-coloured text on bg/surface/subtle" }
      },
      "success": {
        "solid": { "$value": "#15803D" },
        "on": { "$value": "#FFFFFF" },
        "subtle": { "$value": "#DCFCE7" },
        "text": { "$value": "#166534" }
      },
      "warning": {
        "solid": { "$value": "#B45309" },
        "on": { "$value": "#FFFFFF" },
        "subtle": { "$value": "#FEF3C7" },
        "text": { "$value": "#92400E" }
      },
      "danger": {
        "solid": { "$value": "#DC2626" },
        "on": { "$value": "#FFFFFF" },
        "subtle": { "$value": "#FEE2E2" },
        "text": { "$value": "#B91C1C" }
      },
      "info": {
        "solid": { "$value": "#0369A1" },
        "on": { "$value": "#FFFFFF" },
        "subtle": { "$value": "#E0F2FE" },
        "text": { "$value": "#075985" }
      },
      "sidebar": {
        "solid": { "$value": "#0F172A", "$description": "Navigation sidebar background: dark navy in every theme" },
        "hover": { "$value": "#18233A", "$description": "Sidebar item hover" },
        "active": { "$value": "#1E293B", "$description": "Current sidebar item" },
        "text": { "$value": "#E2E8F0", "$description": "Sidebar labels and the wordmark" },
        "muted": { "$value": "#94A3B8", "$description": "Sidebar section headings and secondary text" },
        "accent": { "$value": "#2DD4BF", "$description": "Current-item bar and icon in the sidebar" },
        "border": { "$value": "#1E293B", "$description": "Sidebar dividers (decorative)" }
      },
      "chart": {
        "1": { "$value": "#0D9488", "$description": "Categorical series 1 (teal)" },
        "2": { "$value": "#0284C7", "$description": "Categorical series 2 (blue)" },
        "3": { "$value": "#6366F1", "$description": "Categorical series 3 (indigo)" },
        "4": { "$value": "#D97706", "$description": "Categorical series 4 (amber)" },
        "5": { "$value": "#059669", "$description": "Categorical series 5 (green)" },
        "track": { "$value": "#E2E8F0", "$description": "Unfilled part of a gauge, meter or bar (decorative)" }
      }
    },
    "dark": {
      "bg": { "$value": "#0B1120", "$description": "App canvas behind surfaces" },
      "surface": { "$value": "#111827", "$description": "Cards, tables, drawers, dialogs, inputs" },
      "sunken": { "$value": "#1A2233", "$description": "Table header, wells, hover row" },
      "text": { "$value": "#E5E9F0", "$description": "Primary text" },
      "muted": { "$value": "#9AA6B8", "$description": "Secondary text, placeholders, helper text" },
      "border": { "$value": "#243042", "$description": "Decorative dividers, card outlines" },
      "border-strong": { "$value": "#6B7A90", "$description": "Input, checkbox, radio outlines (meets 3:1 UI contrast)" },
      "focus": { "$value": "#7DA2FF", "$description": "2px focus ring + 2px offset" },
      "scrim": { "$value": "#000000", "$description": "Modal scrim colour; use at 60% opacity" },
      "primary": {
        "solid": { "$value": "#2DD4BF" },
        "hover": { "$value": "#5EEAD4" },
        "on": { "$value": "#042F2E", "$description": "Dark text on light-blue solid in dark mode" },
        "subtle": { "$value": "#0D2E2D" },
        "text": { "$value": "#5EEAD4" }
      },
      "success": {
        "solid": { "$value": "#4ADE80" },
        "on": { "$value": "#052E16" },
        "subtle": { "$value": "#0F2A1C" },
        "text": { "$value": "#86EFAC" }
      },
      "warning": {
        "solid": { "$value": "#FBBF24" },
        "on": { "$value": "#1C1000" },
        "subtle": { "$value": "#33260A" },
        "text": { "$value": "#FCD34D" }
      },
      "danger": {
        "solid": { "$value": "#F87171" },
        "on": { "$value": "#1F0507" },
        "subtle": { "$value": "#3A1518" },
        "text": { "$value": "#FCA5A5" }
      },
      "info": {
        "solid": { "$value": "#38BDF8" },
        "on": { "$value": "#041823" },
        "subtle": { "$value": "#0C2A3B" },
        "text": { "$value": "#7DD3FC" }
      },
      "sidebar": {
        "solid": { "$value": "#070B14", "$description": "Navigation sidebar background: dark navy in every theme" },
        "hover": { "$value": "#111A2B", "$description": "Sidebar item hover" },
        "active": { "$value": "#162032", "$description": "Current sidebar item" },
        "text": { "$value": "#E2E8F0", "$description": "Sidebar labels and the wordmark" },
        "muted": { "$value": "#94A3B8", "$description": "Sidebar section headings and secondary text" },
        "accent": { "$value": "#2DD4BF", "$description": "Current-item bar and icon in the sidebar" },
        "border": { "$value": "#1A2333", "$description": "Sidebar dividers (decorative)" }
      },
      "chart": {
        "1": { "$value": "#2DD4BF", "$description": "Categorical series 1 (teal)" },
        "2": { "$value": "#38BDF8", "$description": "Categorical series 2 (blue)" },
        "3": { "$value": "#818CF8", "$description": "Categorical series 3 (indigo)" },
        "4": { "$value": "#FBBF24", "$description": "Categorical series 4 (amber)" },
        "5": { "$value": "#34D399", "$description": "Categorical series 5 (green)" },
        "track": { "$value": "#243042", "$description": "Unfilled part of a gauge, meter or bar (decorative)" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Inter if bundled locally by the app; otherwise the system UI font. No remote font loading (self-hosted/air-gapped editions)." },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"], "$description": "Asset tags, serial numbers, codes" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px", "$description": "Badges, captions, table meta (not for essential body text on mobile)" },
      "sm": { "$value": "13px", "$description": "Dense table cells" },
      "base": { "$value": "14px", "$description": "Web admin body" },
      "md": { "$value": "16px", "$description": "Mobile body; form inputs on mobile (prevents iOS zoom)" },
      "lg": { "$value": "18px", "$description": "Section titles, mobile card title" },
      "xl": { "$value": "20px", "$description": "Page title (web)" },
      "2xl": { "$value": "24px", "$description": "Page title (large), mobile screen title" },
      "3xl": { "$value": "30px", "$description": "Onboarding / login headline" }
    },
    "lineHeight": {
      "$type": "dimension",
      "xs": { "$value": "16px" },
      "sm": { "$value": "20px" },
      "base": { "$value": "20px" },
      "md": { "$value": "24px" },
      "lg": { "$value": "26px" },
      "xl": { "$value": "28px" },
      "2xl": { "$value": "32px" },
      "3xl": { "$value": "38px" }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "0.5": { "$value": "2px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "size": {
    "$type": "dimension",
    "control-dense": { "$value": "28px", "$description": "Web dense table-row controls (min target 24x24 per WCAG 2.5.8)" },
    "control": { "$value": "36px", "$description": "Web default input/button height" },
    "control-touch": { "$value": "44px", "$description": "Mobile minimum touch target (iOS HIG 44pt)" },
    "control-touch-lg": { "$value": "52px", "$description": "Mobile primary action button" },
    "icon-sm": { "$value": "16px" },
    "icon-md": { "$value": "20px" },
    "icon-lg": { "$value": "24px" },
    "sidebar": { "$value": "232px" },
    "sidebar-collapsed": { "$value": "56px" },
    "drawer": { "$value": "480px" },
    "content-max": { "$value": "1440px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px", "$description": "Badges, checkboxes, table chips" },
    "md": { "$value": "6px", "$description": "Inputs, buttons" },
    "lg": { "$value": "8px", "$description": "Cards, popovers, menus" },
    "xl": { "$value": "12px", "$description": "Dialogs, drawers, mobile bottom sheets (top corners)" },
    "full": { "$value": "9999px", "$description": "Pills, avatars, switches" }
  },
  "shadow": {
    "$type": "shadow",
    "light": {
      "sm": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#14171F14" } },
      "md": { "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px", "color": "#14171F1F" } },
      "lg": { "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-4px", "color": "#14171F2E" } }
    },
    "dark": {
      "sm": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#00000066" } },
      "md": { "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px", "color": "#00000080" } },
      "lg": { "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-4px", "color": "#000000A6" } }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "100ms" },
    "base": { "$value": "160ms" },
    "slow": { "$value": "240ms" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  },
  "zIndex": {
    "$type": "number",
    "sticky": { "$value": 10 },
    "drawer": { "$value": 40 },
    "dialog": { "$value": 50 },
    "popover": { "$value": 60 },
    "toast": { "$value": 70 }
  }
}
