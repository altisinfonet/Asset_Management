{
  "name": "@assettracker/ui-tokens",
  "version": "0.2.7",
  "private": true,
  "description": "Design tokens shared by web and mobile, generated from docs/design/tokens.json (CSS variables, Tailwind v4 theme, typed object, WCAG contrast checks)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": {
      "style": "./dist/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./tailwind-theme.css": {
      "style": "./dist/tailwind-theme.css",
      "default": "./dist/tailwind-theme.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
